# --- environment / secrets (sops + age) -------------------------------------
# Only env/enc/*.env.enc is tracked. Every plaintext form stays out of git;
# `just env-check` enforces it. See env/README.md.
.env
.env.*
!.env.example

# age private keys — never commit these.
*.agekey
*.age-key
keys.txt
sops-private*.txt

# Local temporary directories and repository-owned worktrees
tmp/
temp/
# >>> ores fleet hygiene — managed block, edits below are overwritten >>>
tmp/temp/
tmp/worktrees/
# <<< ores fleet hygiene <<<
# Repository-local temporary data and authorized Git worktrees
tmp/worktrees
temp/worktrees

# machine-local symlink to ORESoftware/my-ai AGENTS.md; never committed
.ores/

# ORESoftware SOPS dotenv ignore contract (ORESoftware/.github docs/sops-environment-standard.md)
*.env
*/*.env
*/**/*.env
.env.*
*.env.*
!.env.example

/env/dec/

/env/enc/*
